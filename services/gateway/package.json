{
  "name": "@locallink/gateway",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "prisma generate && vitest run",
    "test:coverage": "prisma generate && vitest run --coverage",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.14",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.3",
    "@locallink/shared": "workspace:*",
    "@locallink/validators": "workspace:*",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@prisma/client": "^6.2.1",
    "better-auth": "^1.7.14",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "prisma": "^6.2.1",
    "resend": "^6.37.0",
    "socket.io": "^4.8.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@locallink/tsconfig": "workspace:*",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12"
  }
}
